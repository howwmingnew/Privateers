{
  "name": "privateers",
  "private": true,
  "description": "Top-down pirate naval battle browser game (Phaser 3). No build step: open index.html.",
  "scripts": {
    "og": "node tools/og-build.mjs",
    "serve": "python -m http.server 8765 --bind 127.0.0.1",
    "test": "node tools/run-tests.mjs ci",
    "test:unit": "node tools/run-tests.mjs unit",
    "test:smoke": "node tools/run-tests.mjs smoke",
    "test:audio": "node tools/run-tests.mjs audio",
    "test:all": "node tools/run-tests.mjs all",
    "test:quick": "node tools/run-tests.mjs quick",
    "fonts": "node tools/font-subset.mjs --write",
    "fonts:check": "node tools/font-subset.mjs --check",
    "portal": "node tools/build-portal.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
